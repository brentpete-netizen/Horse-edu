# Notion — Horse Breeds content (Status = Ready only)
#
# 1. Create an internal integration at https://www.notion.so/my-integrations
# 2. Copy the integration secret into NOTION_API_KEY
# 3. Open the Horse Breeds database → ••• → Connections → connect this integration
# 4. Restart `npm run dev` / redeploy
#
# Without NOTION_API_KEY the site builds and runs, but breed pages show a
# soft “not connected” state instead of live data.

NOTION_API_KEY=

# Database id from the Notion URL (hyphens optional):
# https://app.notion.com/p/6da68778bc0d4252a72219ad9f7ca46b
NOTION_DATABASE_ID=6da68778-bc0d-4252-a722-19ad9f7ca46b

# Data source (collection) id — used by the Notion API query endpoint.
# Defaults to the Horse Breeds collection if unset.
NOTION_DATA_SOURCE_ID=a52b7896-d472-4792-ad64-542b24a2f3ce
