# Notion — Horse Breeds (Status = Ready only)
# Used on Vercel / local when GITHUB_PAGES is not set.
#
# 1. Create an internal integration at https://www.notion.so/my-integrations
# 2. Copy the secret into NOTION_API_KEY
# 3. Connect the integration to the Horse Breeds database
#
# GitHub Pages builds ignore Notion and use content/breeds only.

NOTION_API_KEY=

NOTION_DATABASE_ID=6da68778-bc0d-4252-a722-19ad9f7ca46b
NOTION_DATA_SOURCE_ID=a52b7896-d472-4792-ad64-542b24a2f3ce

# Optional: force local breeds even when NOTION_API_KEY is set
# FORCE_LOCAL_BREEDS=true

# Set automatically in GitHub Actions for Pages (do not set on Vercel)
# GITHUB_PAGES=true
